{
  "manifest_version": 3,
  "name": "Job Fill",
  "version": "0.1.0",
  "description": "Draft job-application answers from your resume. You review them before they go into the form.",
  "action": {
    "default_title": "Job Fill",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "permissions": ["storage", "activeTab", "scripting", "contextMenus"],
  "host_permissions": ["https://api.openai.com/*", "https://*/*", "http://*/*"],
  "commands": {
    "draft-focused": {
      "suggested_key": {
        "default": "Alt+Shift+J",
        "mac": "Alt+Shift+J"
      },
      "description": "Draft an answer for the focused application field"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content-bundle.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
